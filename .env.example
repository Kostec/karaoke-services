# Настройки karaoke-services.
# Скопируй этот файл в .env и поправь значения. Файл .env в git не попадает.
# Без .env сервис стартует с безопасными умолчаниями ниже.

# ---------------------------------------------------------------- Веб-интерфейс

# Порт веб-интерфейса на ПК (http://<адрес-ПК>:8090; 8080 на этом ПК занят jenkins).
WEB_PORT=8090
# Имя сервиса в домашней сети (запись LAN DNS роутера → IP ПК): веб открывается по https://<имя>
# через прокси Caddy на портах 80/443; корневой сертификат для устройств — http://<имя>/ca.crt
LAN_HOSTNAME=karaoke.home
# Общий пароль на вход (HTTP Basic, логин любой). Пусто — вход без пароля.
WEB_PASSWORD=
# Максимальный размер загружаемого файла (аудио, текст, обложка), МБ.
MAX_UPLOAD_MB=50
# Максимальный размер архива импорта (zip из файлов или по ссылке), МБ; распаковка — до двойного.
MAX_IMPORT_MB=500
# Максимальный размер видеофайла, прикрепляемого к песне, МБ.
MAX_VIDEO_MB=2000

# ---------------------------------------------------------------- Папка результата

# Куда выкладывать готовые песни по умолчанию: smb (шара Raspberry Pi) или local (папка ПК).
# Цель можно поменять в вебе — тогда она хранится в томе data.
OUTPUT_KIND=smb
# Адрес Samba-сервера (Raspberry Pi). Имя pi.local в контейнере не резолвится — нужен IP.
OUTPUT_SMB_HOST=192.168.0.129
# Имя шары на Samba-сервере.
OUTPUT_SMB_SHARE=karaoke
# Путь внутри шары (пусто — корень шары = папка songs UltraStar).
OUTPUT_SMB_PATH=
# Логин Samba. Впиши сам; в интерфейсе и API он не показывается вместе с паролем.
OUTPUT_SMB_USER=
# Пароль Samba. Впиши сам; API его никогда не возвращает.
OUTPUT_SMB_PASSWORD=
# Корень локальной папки ПК, который монтируется в контейнеры как /output
# (для OUTPUT_KIND=local и выбора папки в вебе). Можно целый диск, например D:/
LOCAL_OUTPUT_ROOT=./output
# Корень «Папок ПК» (монтируется в контейнеры как /host): внутри него в «Настройках» можно
# выбрать любую папку для хранилища. Другой диск — сменить, например на E:/, и выполнить up -d.
HOST_FOLDERS_ROOT=D:/

# ---------------------------------------------------------------- Хранение

# Сколько дней хранить удалённые и заменённые песни в корзине (том data).
TRASH_DAYS=30
# Сколько дней хранить логи заданий (том data).
LOG_DAYS=30
# Часовой пояс контейнеров (для времени в логах).
TZ=Europe/Moscow

# ---------------------------------------------------------------- UltraSinger и генерация

# Откуда собирать UltraSinger в образ worker: git-URL с веткой после # или путь к папке.
ULTRASINGER_GIT=https://github.com/Kostec/UltraSinger.git#karaoke-local
# Модель Whisper по умолчанию: tiny, base, small, medium, large-v1, large-v2, large-v3.
DEFAULT_WHISPER_MODEL=large-v2
# Язык песни по умолчанию (код ISO 639-1).
DEFAULT_LANGUAGE=ru
# Тип вычислений Whisper. Для GTX 1080 только int8 (float16 карта не тянет).
DEFAULT_COMPUTE_TYPE=int8
# Размер батча Whisper (меньше — меньше видеопамяти).
DEFAULT_BATCH_SIZE=4
# Модель выравнивания (wav2vec2) для русского языка.
DEFAULT_ALIGN_MODEL_RU=jonatasgrosman/wav2vec2-large-xlsr-53-russian
# Команда yt-dlp: веб — данные по ссылке, воркер — загрузка звука (пусто — python -m yt_dlp из образа).
YTDLP_CMD=
# Токен Яндекс Музыки для CLI karaoke_core.musiclink; воркер подставляет его сам из «Настроек» — здесь оставить пустым.
YANDEX_MUSIC_TOKEN=
# Команда загрузки трека Яндекс Музыки для воркера (пусто — python -m karaoke_core.musiclink; в тестах — фейк).
MUSICLINK_CMD=
