# Образ для прогона тестов ядра (сервис `tests`, профиль `test`).
# Исходники монтируются в /app, поэтому пакет ставится в editable-режиме:
# правки видны без пересборки образа.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY core/ /app/core/
RUN pip install -e "/app/core[dev]"
CMD ["pytest", "-q", "-p", "no:cacheprovider", "--import-mode=importlib", "tests"]
