# Образ для прогона тестов (сервис `tests`, профиль `test`).
# Исходники монтируются в /app, поэтому пакеты ставятся в editable-режиме:
# правки видны без пересборки образа (после смены зависимостей — `run --build`).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY core/ /app/core/
RUN pip install -e "/app/core[dev]"
# Веб (таск 05): FastAPI + TestClient для тестов tests/api.
COPY web/pyproject.toml /app/web/pyproject.toml
COPY web/app/ /app/web/app/
RUN pip install -e "/app/web[dev]"
CMD ["pytest", "-q", "-p", "no:cacheprovider", "--import-mode=importlib", "tests"]
