diff --git a/src/modules/Speech_Recognition/lrc_timing.py b/src/modules/Speech_Recognition/lrc_timing.py
new file mode 100644
index 0000000..9b49a2b
--- /dev/null
+++ b/src/modules/Speech_Recognition/lrc_timing.py
@@ -0,0 +1,115 @@
+"""Line timing from LRC for lyrics-guided transcription (local patch: --lyrics_timing).
+
+If the lyrics come with an LRC file (e.g. syncedLyrics from LRCLIB), every lyric line
+already has its start time. Then the windows for the second whisperx.align pass are
+taken from the LRC tags instead of guessing them from whisper's recognized words.
+Pure functions only (no torch / whisperx imports) so they can be tested without models.
+"""
+
+import re
+
+from modules.console_colors import ULTRASINGER_HEAD, blue_highlighted, red_highlighted
+from modules.Speech_Recognition.lyrics_alignment import _norm_words
+
+LRC_PAD = 0.5  # seconds before the line tag and after the next line tag
+MIN_WINDOW = 0.3
+
+_TIME_TAG_RE = re.compile(r"\[(\d+):(\d{1,2})(?:[.:](\d{1,3}))?\]")
+_OFFSET_RE = re.compile(r"^\s*\[offset:\s*([+-]?\d+)\s*\]\s*$", re.IGNORECASE)
+_TAG_ONLY_LINE_RE = re.compile(r"^\s*\[[^\]]*\]\s*$")  # [Chorus], [Припев]
+
+
+def _tag_seconds(match) -> float:
+    minutes, seconds, fraction = match.group(1), match.group(2), match.group(3)
+    value = int(minutes) * 60 + int(seconds)
+    if fraction:
+        value += int(fraction) / (10 ** len(fraction))
+    return value
+
+
+def parse_lrc(text: str) -> list:
+    """LRC text -> [(seconds, line_text)] sorted by time.
+
+    Supports [mm:ss.xx], [mm:ss.xxx], [mm:ss], several time tags per line,
+    metadata tags ([ar:...], [ti:...]) and [offset:+/-ms] (positive = lyrics sooner).
+    Lines with a time tag but without text (pauses) are kept with "" text.
+    """
+    offset = 0.0
+    entries = []
+    for raw in (text or "").lstrip("﻿").splitlines():
+        offset_match = _OFFSET_RE.match(raw)
+        if offset_match:
+            offset = int(offset_match.group(1)) / 1000
+            continue
+        line = raw.strip()
+        times = []
+        while True:
+            match = _TIME_TAG_RE.match(line)
+            if not match:
+                break
+            times.append(_tag_seconds(match))
+            line = line[match.end():].lstrip()
+        if not times:
+            continue  # metadata or plain text
+        line = re.sub(r"\s+", " ", line).strip()
+        for t in times:
+            entries.append((t, line))
+    entries = [(round(max(t - offset, 0.0), 3), line) for t, line in entries]
+    entries.sort(key=lambda e: e[0])
+    return entries
+
+
+def normalize_line(text: str) -> str:
+    """Line key for comparing lyrics with LRC: lower case, ё->е, no punctuation, single spaces."""
+    return " ".join(_norm_words(text or ""))
+
+
+def match_lrc_lines(lyrics_lines: list, lrc_entries: list):
+    """Start time for every lyric line, matched to LRC lines in order.
+
+    LRC lines without words (pauses, [Chorus]-style tags) are skipped.
+    Returns None if the number of lines or any normalized line differs.
+    """
+    sung = [(t, line) for t, line in lrc_entries
+            if not _TAG_ONLY_LINE_RE.match(line) and normalize_line(line)]
+    if not lyrics_lines or len(sung) != len(lyrics_lines):
+        return None
+    for (_, lrc_line), lyric_line in zip(sung, lyrics_lines):
+        if normalize_line(lrc_line) != normalize_line(lyric_line):
+            return None
+    return [t for t, _ in sung]
+
+
+def build_lrc_segments(lyrics_lines: list, line_times: list, audio_duration: float) -> list:
+    """Whisperx-style segments [{"text", "start", "end"}] for the second whisperx.align pass.
+
+    Window of a line = [its tag - 0.5 s; next line's tag + 0.5 s], the last line lasts
+    to the end of the audio; bounds are clamped to [0; audio_duration].
+    """
+    segments = []
+    for i, (line, t) in enumerate(zip(lyrics_lines, line_times)):
+        end = line_times[i + 1] + LRC_PAD if i + 1 < len(line_times) else audio_duration
+        end = min(max(end, 0.0), audio_duration)
+        start = min(max(t - LRC_PAD, 0.0), audio_duration)
+        start = min(start, max(end - MIN_WINDOW, 0.0))  # tag at/after the end of audio
+        segments.append({"text": line, "start": round(start, 3), "end": round(end, 3)})
+    return segments
+
+
+def load_lrc_line_times(lrc_path: str, lyrics_lines: list):
+    """--lyrics_timing: start time for every lyric line from the LRC file, or None (with a warning)."""
+    reason = None
+    try:
+        with open(lrc_path, encoding="utf-8-sig") as f:
+            entries = parse_lrc(f.read())
+    except (OSError, UnicodeError) as e:  # unreadable or not UTF-8
+        entries, reason = [], f"cannot read {lrc_path}: {e}"
+    times = match_lrc_lines(lyrics_lines, entries) if reason is None else None
+    if times is None:
+        if reason is None:
+            sung = sum(1 for _, line in entries if not _TAG_ONLY_LINE_RE.match(line) and normalize_line(line))
+            reason = f"lyrics differ from LRC lines ({len(lyrics_lines or [])} lyric lines, {sung} LRC lines)"
+        print(f"{ULTRASINGER_HEAD} {red_highlighted('LRC line timing not used:')} {reason}")
+        return None
+    print(f"{ULTRASINGER_HEAD} Line timing from LRC {blue_highlighted(lrc_path)} ({len(times)} lines)")
+    return times
