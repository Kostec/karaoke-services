+"""Tests for lrc_timing.py (local patch: --lyrics_timing)"""
+
+import pytest
+
+from modules.Speech_Recognition.lrc_timing import build_lrc_segments, load_lrc_line_times, match_lrc_lines, normalize_line, parse_lrc
+
+
+def test_parse_lrc_formats_metadata_and_pauses():
+    text = (
+        "﻿[ar:Кино]\n"
+        "[ti:Группа крови]\n"
+        "[00:12.50]Тёплое место, но улицы ждут\r\n"
+        "[00:17]Отпечатков наших ног\n"
+        "[00:20.00]\n"
+        "[01:02.345]Звёздная пыль на сапогах\n"
+    )
+    assert parse_lrc(text) == [
+        (12.5, "Тёплое место, но улицы ждут"),
+        (17.0, "Отпечатков наших ног"),
+        (20.0, ""),
+        (62.345, "Звёздная пыль на сапогах"),
+    ]
+
+
+def test_parse_lrc_several_tags_per_line_are_sorted():
+    text = "[00:10.00][00:30.00]Chorus line\n[00:20.00]Verse line\n"
+    assert parse_lrc(text) == [(10.0, "Chorus line"), (20.0, "Verse line"), (30.0, "Chorus line")]
+
+
+def test_parse_lrc_offset_positive_shows_lyrics_sooner():
+    text = "[offset:+500]\n[00:01.00]a\n[00:10.00]b\n"
+    assert parse_lrc(text) == [(0.5, "a"), (9.5, "b")]
+
+
+def test_parse_lrc_offset_negative_and_clamped_to_zero():
+    assert parse_lrc("[offset:-250]\n[00:01.00]a\n") == [(1.25, "a")]
+    assert parse_lrc("[offset:2000]\n[00:01.00]a\n") == [(0.0, "a")]
+
+
+def test_parse_lrc_ignores_plain_text_lines():
+    assert parse_lrc("no tags here\n[00:05.00]x\n") == [(5.0, "x")]
+
+
+def test_normalize_line_ignores_case_spaces_punctuation_and_yo():
+    assert normalize_line("  Тёплое   место, НО улицы — ждут! ") == "теплое место но улицы ждут"
+
+
+def test_match_lrc_lines_skips_pauses_and_tag_lines():
+    lyrics = ["Тёплое место, но улицы ждут", "отпечатков наших ног"]
+    entries = [(1.0, "[Куплет]"), (12.5, "теплое место но улицы ждут"), (15.0, ""), (17.0, "Отпечатков  наших ног.")]
+    assert match_lrc_lines(lyrics, entries) == [12.5, 17.0]
+
+
+def test_match_lrc_lines_mismatch_returns_none():
+    entries = [(1.0, "first line"), (2.0, "second line")]
+    assert match_lrc_lines(["first line"], entries) is None                       # different count
+    assert match_lrc_lines(["first line", "edited line"], entries) is None        # different text
+    assert match_lrc_lines(["first line", "second line"], []) is None
+
+
+def test_build_lrc_segments_windows_by_rule():
+    lyrics = ["Line one", "Line two", "Line three"]
+    segments = build_lrc_segments(lyrics, [0.2, 10.0, 20.0], 30.0)
+    assert segments == [
+        {"text": "Line one", "start": 0.0, "end": 10.5},     # 0.2 - 0.5 clamped to 0
+        {"text": "Line two", "start": 9.5, "end": 20.5},
+        {"text": "Line three", "start": 19.5, "end": 30.0},  # last line: to the end of audio
+    ]
+
+
+def test_build_lrc_segments_clamped_to_duration():
+    segments = build_lrc_segments(["a", "b"], [5.0, 9.8], 10.0)
+    assert segments == [{"text": "a", "start": 4.5, "end": 10.0}, {"text": "b", "start": 9.3, "end": 10.0}]
+
+
+def test_load_lrc_line_times_matching_file(tmp_path):
+    lrc = tmp_path / "lyrics.lrc"
+    lrc.write_text("[ar:x]\n[00:01.00]Hello, world\n[00:02.00]\n[00:03.50]Bye\n", encoding="utf-8")
+    assert load_lrc_line_times(str(lrc), ["hello world", "Bye!"]) == [1.0, 3.5]
+
+
+def test_load_lrc_line_times_mismatch_warns(tmp_path, capsys):
+    lrc = tmp_path / "lyrics.lrc"
+    lrc.write_text("[00:01.00]Hello\n[00:03.50]Bye\n", encoding="utf-8")
+    assert load_lrc_line_times(str(lrc), ["Hello", "Edited"]) is None
+    assert "LRC line timing not used" in capsys.readouterr().out
+
+
+def test_load_lrc_line_times_missing_file_warns(tmp_path, capsys):
+    assert load_lrc_line_times(str(tmp_path / "nope.lrc"), ["Hello"]) is None
+    assert "LRC line timing not used" in capsys.readouterr().out
+
+
+def test_load_lrc_line_times_undecodable_file_warns(tmp_path, capsys):
+    lrc = tmp_path / "lyrics.lrc"
+    lrc.write_bytes("[00:01.00]Привет\n".encode("cp1251") + b"\xff\xfe\x81\n")
+    assert load_lrc_line_times(str(lrc), ["Привет"]) is None
+    assert "LRC line timing not used" in capsys.readouterr().out
