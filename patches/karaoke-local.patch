 1 file changed, 273 insertions(+)
 create mode 100644 src/modules/Speech_Recognition/lyrics_alignment.py

diff --git a/src/modules/Speech_Recognition/lyrics_alignment.py b/src/modules/Speech_Recognition/lyrics_alignment.py
new file mode 100644
index 0000000..905b8dc
--- /dev/null
+++ b/src/modules/Speech_Recognition/lyrics_alignment.py
@@ -0,0 +1,273 @@
+"""Lyrics-guided transcription helpers (local patch).
+
+Whisper is good at *when* something is sung, but often wrong at *what* is sung
+(metal vocals, screams) and hallucinates subtitle credits on instrumental parts.
+If the user provides the real lyrics, we keep Whisper only as a timing anchor:
+the real lyric lines are placed into time windows found by matching them
+against Whisper's words, and then wav2vec2 forced alignment (whisperx.align)
+places every real word precisely inside its window.
+"""
+
+import os
+import re
+from difflib import SequenceMatcher
+
+from modules.console_colors import ULTRASINGER_HEAD, blue_highlighted, red_highlighted
+
+# Typical Whisper hallucinations (mostly from subtitle credits in its training data)
+HALLUCINATION_PATTERNS = [
+    r"субтитр",
+    r"dimatorzok",
+    r"продолжение\s+следует",
+    r"спасибо\s+за\s+просмотр",
+    r"подпис(ывайтесь|ывайся)",
+    r"ставьте\s+лайк",
+    r"редактор\s+субтитров",
+    r"корректор",
+    r"amara\.org",
+    r"thanks?\s+(you\s+)?for\s+watching",
+    r"subtitles?\s+by",
+    r"untertitel",
+]
+_HALLUCINATION_RE = re.compile("|".join(HALLUCINATION_PATTERNS), re.IGNORECASE)
+
+MIN_WORD_SIMILARITY = 0.6     # whisper word vs lyric word to count as the same word
+MIN_LINE_SIMILARITY = 0.55    # unmatched whisper segment vs lyric line (repeated chorus)
+GAP_PENALTY = -0.4
+SECONDS_PER_UNMATCHED_WORD = 0.5
+LINE_PAD = 0.25
+MIN_WINDOW = 0.3
+MAX_GAP_INSIDE_LINE = 3.0     # seconds between two consecutive words of one sung line
+
+
+def is_hallucination(text: str) -> bool:
+    return bool(_HALLUCINATION_RE.search(text or ""))
+
+
+def filter_hallucinations(segments: list) -> list:
+    """Drop whisper segments that look like subtitle-credit hallucinations."""
+    kept = []
+    for seg in segments:
+        if is_hallucination(seg.get("text", "")):
+            print(f"{ULTRASINGER_HEAD} {red_highlighted('Removed hallucination:')} {seg.get('text', '').strip()}")
+        else:
+            kept.append(seg)
+    return kept
+
+
+def find_lyrics_file(input_file_path: str, explicit_path: str = None):
+    """<song>.lyrics.txt next to the input file, or an explicit --lyrics path."""
+    if explicit_path:
+        return explicit_path if os.path.isfile(explicit_path) else None
+    if not input_file_path or input_file_path.startswith("http"):
+        return None
+    base, _ = os.path.splitext(input_file_path)
+    for candidate in (base + ".lyrics.txt", base + ".txt.lyrics", base + ".lrc.txt"):
+        if os.path.isfile(candidate):
+            return candidate
+    return None
+
+
+def read_lyrics(path: str) -> list:
+    """Non-empty lines; [Chorus]-style tags and LRC timestamps are removed."""
+    with open(path, encoding="utf-8-sig") as f:
+        raw = f.read().splitlines()
+    lines = []
+    for line in raw:
+        line = re.sub(r"\[\d{1,2}:\d{2}(\.\d+)?\]", "", line)   # LRC timestamps
+        line = re.sub(r"^\s*\[[^\]]*\]\s*$", "", line)          # [Припев], [Chorus]
+        line = re.sub(r"\s+", " ", line).strip()
+        if line and _norm_words(line):
+            lines.append(line)
+    return lines
+
+
+def _norm_word(word: str) -> str:
+    word = word.lower().replace("ё", "е")
+    return re.sub(r"[^\w]", "", word)
+
+
+def _norm_words(text: str) -> list:
+    return [w for w in (_norm_word(t) for t in text.split()) if w]
+
+
+def _sim(a: str, b: str) -> float:
+    if a == b:
+        return 1.0
+    return SequenceMatcher(None, a, b).ratio()
+
+
+def _align_words(lyric_words: list, whisper_words: list) -> dict:
+    """Needleman-Wunsch over words with fuzzy matching. Returns {lyric_idx: whisper_idx}."""
+    n, m = len(lyric_words), len(whisper_words)
+    neg = float("-inf")
+    score = [[0.0] * (m + 1) for _ in range(n + 1)]
+    back = [[0] * (m + 1) for _ in range(n + 1)]  # 1 = diag, 2 = up (skip lyric), 3 = left (skip whisper)
+    for i in range(1, n + 1):
+        score[i][0] = i * GAP_PENALTY
+        back[i][0] = 2
+    for j in range(1, m + 1):
+        score[0][j] = j * GAP_PENALTY
+        back[0][j] = 3
+    for i in range(1, n + 1):
+        lw = lyric_words[i - 1]
+        for j in range(1, m + 1):
+            s = _sim(lw, whisper_words[j - 1])
+            diag = score[i - 1][j - 1] + (2 * s - 0.2) if s >= MIN_WORD_SIMILARITY else neg
+            up = score[i - 1][j] + GAP_PENALTY
+            left = score[i][j - 1] + GAP_PENALTY
+            best = max(diag, up, left)
+            score[i][j] = best
+            back[i][j] = 1 if best == diag else (2 if best == up else 3)
+    mapping = {}
+    i, j = n, m
+    while i > 0 or j > 0:
+        b = back[i][j]
+        if b == 1:
+            mapping[i - 1] = j - 1
+            i, j = i - 1, j - 1
+        elif b == 2:
+            i -= 1
+        else:
+            j -= 1
+    return mapping
+
+
+def build_lyrics_segments(whisper_aligned: dict, lyrics_lines: list, audio_duration: float) -> list:
+    """Place lyric lines into time windows using aligned whisper words as anchors.
+
+    whisper_aligned: result of whisperx.align on whisper's own transcription.
+    Returns whisperx-style segments [{"text", "start", "end"}] for a second whisperx.align pass.
+    """
+    # Whisper words with timing
+    w_words, w_times, w_seg = [], [], []
+    for seg_idx, seg in enumerate(whisper_aligned.get("segments", [])):
+        for w in seg.get("words", []):
+            if "start" not in w or "end" not in w:
+                continue
+            for token in _norm_words(w.get("word", "")):
+                w_words.append(token)
+                w_times.append((float(w["start"]), float(w["end"])))
+                w_seg.append(seg_idx)
+
+    # Lyric words
+    l_words, l_line = [], []
+    line_words = []
+    for line_idx, line in enumerate(lyrics_lines):
+        words = _norm_words(line)
+        line_words.append(words)
+        for token in words:
+            l_words.append(token)
+            l_line.append(line_idx)
+
+    mapping = _align_words(l_words, w_words) if w_words else {}
+
+    n_lines = len(lyrics_lines)
+    first_word_index = []
+    idx = 0
+    for words in line_words:
+        first_word_index.append(idx)
+        idx += len(words)
+
+    # A line is sung in one go: keep only the biggest time-contiguous cluster of its
+    # matched words (otherwise one chorus line can stretch over several repeats).
+    for li in range(n_lines):
+        start_idx = first_word_index[li]
+        keys = [k for k in range(start_idx, start_idx + len(line_words[li])) if k in mapping]
+        if len(keys) < 2:
+            continue
+        clusters, current = [], [keys[0]]
+        for prev_k, k in zip(keys, keys[1:]):
+            if w_times[mapping[k]][0] - w_times[mapping[prev_k]][1] > MAX_GAP_INSIDE_LINE:
+                clusters.append(current)
+                current = []
+            current.append(k)
+        clusters.append(current)
+        best = max(clusters, key=len)
+        for cluster in clusters:
+            if cluster is not best:
+                for k in cluster:
+                    del mapping[k]
+
+    matched_whisper = set(mapping.values())
+
+    raw = []
+    for li in range(n_lines):
+        start_idx = first_word_index[li]
+        count = len(line_words[li])
+        matched = [(k - start_idx, mapping[k]) for k in range(start_idx, start_idx + count) if k in mapping]
+        if not matched:
+            raw.append(None)
+            continue
+        first_pos, first_w = matched[0]
+        last_pos, last_w = matched[-1]
+        missing_before = first_pos
+        missing_after = count - 1 - last_pos
+        start = w_times[first_w][0] - LINE_PAD - missing_before * SECONDS_PER_UNMATCHED_WORD
+        end = w_times[last_w][1] + LINE_PAD + missing_after * SECONDS_PER_UNMATCHED_WORD
+        raw.append([start, end, len(matched) / count])
+
+    # Make windows monotonic and fill unmatched lines into gaps
+    segments = []
+    unplaced = []
+    prev_end = 0.0
+    for li in range(n_lines):
+        if raw[li] is not None:
+            start, end, _ = raw[li]
+            start = max(start, prev_end)
+            next_start = next((raw[k][0] for k in range(li + 1, n_lines) if raw[k] is not None), audio_duration)
+            end = min(end, max(next_start, start + MIN_WINDOW), audio_duration)
+            if end - start < MIN_WINDOW:
+                end = min(start + MIN_WINDOW, audio_duration)
+        else:
+            next_start = next((raw[k][0] for k in range(li + 1, n_lines) if raw[k] is not None), audio_duration)
+            next_start = max(next_start, prev_end)
+            wanted = len(line_words[li]) * SECONDS_PER_UNMATCHED_WORD * 1.6 + 2 * LINE_PAD
+            start = prev_end
+            end = min(next_start, start + max(wanted, MIN_WINDOW))
+            if end - start < MIN_WINDOW:
+                unplaced.append(lyrics_lines[li])
+                continue
+        segments.append({"text": lyrics_lines[li], "start": round(start, 3), "end": round(end, 3)})
+        prev_end = end
+
+    # Repeated parts: whisper segments that matched nothing but resemble a lyric line
+    lyric_norm_lines = [" ".join(w) for w in line_words]
+    repeats = 0
+    for seg_idx, seg in enumerate(whisper_aligned.get("segments", [])):
+        seg_word_ids = [k for k, s in enumerate(w_seg) if s == seg_idx]
+        if not seg_word_ids:
+            continue
+        matched_share = sum(1 for k in seg_word_ids if k in matched_whisper) / len(seg_word_ids)
+        if matched_share > 0.3:
+            continue
+        seg_text = " ".join(w_words[k] for k in seg_word_ids)
+        best_line, best_sim = None, 0.0
+        for li, norm in enumerate(lyric_norm_lines):
+            s = _sim(seg_text, norm)
+            if s > best_sim:
+                best_line, best_sim = li, s
+        if best_line is None or best_sim < MIN_LINE_SIMILARITY:
+            continue
+        start = w_times[seg_word_ids[0]][0] - LINE_PAD
+        end = w_times[seg_word_ids[-1]][1] + LINE_PAD
+        overlap = any(min(end, s["end"]) - max(start, s["start"]) > 0.5 * (end - start) for s in segments)
+        if overlap:
+            continue
+        segments.append({"text": lyrics_lines[best_line], "start": round(max(start, 0.0), 3),
+                         "end": round(min(end, audio_duration), 3)})
+        repeats += 1
+
+    segments.sort(key=lambda s: s["start"])
+
+    # Resolve overlaps created by inserted repeats
+    for a, b in zip(segments, segments[1:]):
+        if b["start"] < a["end"]:
+            a["end"] = max(a["start"] + MIN_WINDOW / 2, b["start"])
+
+    matched_lines = sum(1 for r in raw if r is not None)
+    print(f"{ULTRASINGER_HEAD} Lyrics: {blue_highlighted(str(matched_lines))}/{n_lines} lines anchored by whisper, "
+          f"{blue_highlighted(str(repeats))} repeated parts detected")
+    for line in unplaced:
+        print(f"{ULTRASINGER_HEAD} {red_highlighted('Lyrics line could not be placed, skipped:')} {line}")
+    return segments
